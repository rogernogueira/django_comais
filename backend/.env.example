# Copy to backend/.env and fill in real values.
# NEVER commit backend/.env.

# --- Django ---
# Required in production; dev gets a random fallback if unset.
DJANGO_SECRET_KEY=

# Required in production only. Comma-separated hostnames Django will accept.
DJANGO_ALLOWED_HOSTS=comais.uft.edu.br,www.comais.uft.edu.br

# --- Database ---
# Omit ALL of these to fall back to SQLite at backend/db.sqlite3 (dev only).
# Set them to switch to MySQL (DigitalOcean managed instance).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
